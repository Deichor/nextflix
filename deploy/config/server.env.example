# Copy to deploy/config/server.env (gitignored) and fill in.
# DATABASE_URL, REDIS_URL, TORRSERVER_URL and JACKETT_URL are set by docker-compose.yml.

# TMDB v4 "API Read Access Token" (the long JWT), sent as a Bearer token
TMDB_API_KEY=

# Jackett API key (top right of the Jackett dashboard). Can also be set in Settings -> Indexer.
JACKETT_API_KEY=

# Extra browser origins allowed by CORS, comma separated (localhost, private IPs and *.local are always allowed)
ALLOWED_ORIGINS=

# Extra host names the server may be reached by, comma separated (e.g. a Tailscale IP or a bare PC name).
# Other names get 403 (DNS rebinding guard); localhost, private IPs, *.local and ALLOWED_ORIGINS hosts always work.
ALLOWED_HOSTS=
